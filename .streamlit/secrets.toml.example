# Streamlit Cloud / ローカル用 Secrets の例
# このファイルはコミットしないでください（.gitignore 済み想定）
# Streamlit Cloud の App settings → Secrets に同じ内容を貼り付けます。

# --- 推奨: サービスアカウント ---
# 共有先メール（このフォルダに閲覧者で共有済み）:
#   vr-ai-analysis-drive-reader@routinesupport.iam.gserviceaccount.com
# フォルダ:
#   https://drive.google.com/drive/folders/1ClTITbRVQc_hiDDIF5lfEEEttJs5qTc9
#
# private_key の書き方（重要）:
# - Cloud Secrets では 1 行文字列で \\n を含める（下の例）
# - または TOML の三重引用符で実改行を含めても可
# - JSON 鍵ファイルの private_key をそのままコピーし、改行を \\n にしたものが確実

[gcp_service_account]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_LINE_1\nYOUR_KEY_LINE_2\n-----END PRIVATE KEY-----\n"
client_email = "vr-ai-analysis-drive-reader@routinesupport.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/vr-ai-analysis-drive-reader%40routinesupport.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# --- 任意フォールバック ---
# GOOGLE_API_KEY = "YOUR_API_KEY"
