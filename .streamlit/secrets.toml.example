# Streamlit Cloud / ローカル用 Secrets の例
# このファイルはコミットしないでください（.gitignore 済み想定）
# Streamlit Cloud の App settings → Secrets に同じ内容を貼り付けます。

# --- 推奨: サービスアカウント ---
# 1. Google Cloud Console でサービスアカウントを作成
# 2. Drive API を有効化
# 3. JSON 鍵を発行し、下の項目に転記
# 4. Google Drive フォルダ
#    https://drive.google.com/drive/folders/1ClTITbRVQc_hiDDIF5lfEEEttJs5qTc9
#    を client_email に「閲覧者」で共有

[gcp_service_account]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
client_email = "YOUR_SA@YOUR_PROJECT.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
token_uri = "https://oauth2.googleapis.com/token"

# --- 任意フォールバック ---
# GOOGLE_API_KEY = "YOUR_API_KEY"
